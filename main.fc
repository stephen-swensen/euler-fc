import io from std::
import sys from std::
import * from prelude

//Find the sum of all the multiples of 3 or 5 below 1000
module problem_01 =
    let solution_a = () ->
        let mut sum = 0
        for i in 1..1_000
            if i % 3 == 0 || i % 5 == 0 then        
                //io.write("%d{i}\n", stdout)
                sum = sum + i
        sum

//Find the sum of the even numbered Fibonacci sequence numbers less than 4 million
module problem_02 =

    let solution_a = () ->
        let next_fib = (prev_prev:int32, prev:int32) ->
            prev_prev + prev

        let mut sum = 0
        let mut prev_prev = 1
        let mut prev = 1
        loop
            let next = next_fib(prev_prev, prev)
            prev_prev = prev
            prev = next
            if next >= 4_000_000 then
                break sum
            else if next % 2 == 0 then
                sum = sum + next

    let solution_b = () -> 
        //note: we did confirm that when compiled with the -O2 tail call optimizations are applied and the generated is turned into a loop)
        let sum_fibs = (prev_prev:int32, prev:int32, sum:int32) ->
            let next = prev_prev + prev
            if next >= 4_000_000 then
                sum
            else
                sum_fibs(prev, 
                         next, 
                         if next % 2 == 0 then sum + next else sum)

        sum_fibs(1, 1, 0)

module problem_03 =
    import array_list from std::data

    //let num = 13
    //let num = 1_600_851_475_143i64
    let num = 600_851_475_143i64
    //let num = 13195i64
    //let num = 100

    let solution_a = () -> 
        let find_odd = (candidate:int64, largest_factor:int64) ->
            if candidate > largest_factor / 2 then
                largest_factor
            else if largest_factor % candidate == 0 then
                find_odd(candidate, largest_factor / candidate)
            else
                find_odd(candidate + 2, largest_factor)

        let find = (largest_factor:int64) ->
            if largest_factor == 1 then
                1i64
            else if largest_factor % 2 == 0 then 
                find(largest_factor / 2)
            else
                find_odd(3, largest_factor)
        find(num)

    let solution_b = () ->
        //let num = 10023202342323i64
        let num = 33333333333333333i64
        //let num = 600_851_475_143i64
        let factors = factorize(num)
        defer array_list.destroy(factors)
        io.write("factors(input=%d{num}):\n", stdout)
        for i in 0..factors.len
            io.write("[%d{i}] %d{array_list.get(factors, i)}\n", stdout)

        array_list.last(factors)

    let solution_c = () ->
        //let num = 10023202342323i64
        let num = 33333333333333333i64
        //let num = 600_851_475_143i64
        let mut factorize_iterator = mk_factorize_iterator(num)
        let mut prev = default(int64?)
        let mut cur = default(int64?)
        io.write("factors(input=%d{num}; lazy):\n", stdout)
        loop
            cur = factorize_iterator.next(&factorize_iterator.state)
            match cur with
            | none -> break prev!
            | some(cur) -> 
                io.write("%d{cur}\n", stdout)
                prev = some(cur)

let main = (args: str[]) ->
    io.write("program: %s{args[0]}\n", stdout)
    if args.len < 2 || args[1] == "" then
        io.write("[exiting] missing arg: please enter the problem identifier (e.g. '01_a')\n", stderr)
        return -1

    io.write("problem: %s{args[1]}\n", stdout)
    
    let start_ms = sys.time()
    match args[1] with
    | "03_c" -> 
        let result = problem_03.solution_c()
        io.write("solution: %d{result}\n", stdout)
    | "03_b" -> 
        let result = problem_03.solution_b()
        io.write("solution: %d{result}\n", stdout)
    | "03_a" -> 
        let result = problem_03.solution_a()
        io.write("solution: %d{result}\n", stdout)
    | "02_b" -> 
        let result = problem_02.solution_b()
        io.write("solution: %d{result}\n", stdout)
    | "02_a" -> 
        let result = problem_02.solution_a()
        io.write("solution: %d{result}\n", stdout)
    | "01_a" -> 
        let result = problem_01.solution_a()
        io.write("solution: %d{result}\n", stdout)
    | _ ->
        io.write("[exiting] unrecognized problem: %s{args[1]}\n", stderr)
    let end_ms = sys.time()
    io.write("elapsed: %d{end_ms - start_ms}ms\n", stdout)
    0
