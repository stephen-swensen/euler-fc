import array_list from std::data

module prelude =
    let factorize = (num:int64) ->
        let mut factors = array_list.make<int64>()
        if num < 2 then
            return factors

        let p = &factors

        let find_odd = (candidate:int64, largest_factor:int64) ->
            if candidate * candidate > largest_factor then
                array_list.add(p, largest_factor)
            else if largest_factor % candidate == 0 then
                array_list.add(p, candidate)
                find_odd(candidate, largest_factor / candidate)
            else
                find_odd(candidate + 2, largest_factor)

        let find = (largest_factor:int64) ->
            if largest_factor == 1 then
                return
            else if largest_factor % 2 == 0 then 
                array_list.add(p, 2i64)
                find(largest_factor / 2)
            else
                find_odd(3, largest_factor)

        find(num)
        factors

    struct iterator =
        state: 'a
        next: ('a*) -> 'b?

    module iterator =
        let next = (it:iterator<'a,'b>*) ->
            it->next(&it->state)

    private struct factorize_state =
        num: int64
        candidate: int64
        done: bool

    private let next_factor = (state: factorize_state*) ->
        if state->done || state->num <= 1 then
            default(int64?)
        else if state->num % 2 == 0 then
            state->num = state->num / 2
            some(2i64)
        else
            loop
                if state->candidate * state->candidate > state->num then
                    state->done = true
                    break some(state->num)
                else if state->num % state->candidate == 0 then
                    state->num = state->num / state->candidate
                    break some(state->candidate)
                else
                    state->candidate = state->candidate + 2

    let mk_factorize_iterator = (num: int64) ->
        iterator {
            state = factorize_state { 
                num = num, 
                candidate = 3i64, 
                done = false 
            },
            next = next_factor
        }
