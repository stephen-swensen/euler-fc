import array_list from std::data
import io from std::

module prelude =
    let factorize = (num:i64) ->
        let factors = array_list.make<i64>()
        if num < 2 then
            return factors

        let find_odd = (candidate:i64, largest_factor:i64) ->
            if candidate * candidate > largest_factor then
                array_list.add(factors, largest_factor)
            else if largest_factor % candidate == 0 then
                array_list.add(factors, candidate)
                find_odd(candidate, largest_factor / candidate)
            else
                find_odd(candidate + 2, largest_factor)

        let find = (largest_factor:i64) ->
            if largest_factor == 1 then
                return
            else if largest_factor % 2 == 0 then 
                array_list.add(factors, 2i64)
                find(largest_factor / 2)
            else
                find_odd(3, largest_factor)

        find(num)
        factors

    struct factorize_iterator =
        num: i64
        candidate: i64

    module factorize_iterator =
        let next = (it: factorize_iterator*) ->
            if it.num <= 1 then
                default(i64?)
            else if it.num % 2 == 0 then
                it.num = it.num / 2
                some(2i64)
            else
                loop
                    if it.candidate * it.candidate > it.num then
                        defer it.num = 1 //short circuit next iteration
                        break some(it.num)
                    else if it.num % it.candidate == 0 then
                        it.num = it.num / it.candidate
                        break some(it.candidate)
                    else
                        it.candidate = it.candidate + 2

        let make = (num:i64) ->
            factorize_iterator { num = num, candidate = 3i64 }

    let is_prime = (num:i64) ->
        let mut it = factorize_iterator.make(num)
        some(num) == factorize_iterator.next(&it)

    let sum_of_squares = (num:i64) ->
        checked
            let mut sum = 0i64
            for n in 1..num+1 do
                sum = sum + (n*n)
            sum

    let square_of_sums = (num:i64) ->
        checked
            let mut sum = 0i64
            for n in 1..num+1 do
                sum = sum + n
            sum * sum
        
    let nth_prime = (target:i32) ->
        let primes = array_list.make<i64>()
        defer array_list.destroy(primes)

        let is_composite = (candidate:i64) ->
            match array_list.try_find(primes, (p:i64) -> p * p > candidate || candidate % p == 0) with
            | some(p) -> candidate % p == 0
            | none -> false

        let mut i = 3i64
        let mut n = 1 //2 is the 1st prime
        loop
            if !is_composite(i) then
                n = n + 1
                //io.write("n=%i{n}, i=%i{i}\n", stdout)
                if n == target then
                    break i
                array_list.add(primes, i)

            i = i + 2
            
    //Sum the primes below num
    let sum_of_primes = (num:i32) ->
        let primes = array_list.make<i64>()
        defer array_list.destroy(primes)

        let is_composite = (candidate:i64) ->
            match array_list.try_find(primes, (p:i64) -> p * p > candidate || candidate % p == 0) with
            | some(p) -> candidate % p == 0
            | none -> false

        match num with
        | 3 -> 2i64
        | _ when num <= 2 -> 0i64
        | _ ->
            array_list.add(primes, 2i64)
            let sum = (i:i64) ->
                if i >= num then
                    array_list.fold_left(primes, 0i64, (x:i64,y:i64) -> checked x + y)
                else
                    if !is_composite(i) then
                        array_list.add(primes, i)
                    sum(i + 2)
            sum(3i64)

    let factorial = (n:i64) ->
        let mut n = n
        let mut product = 1i64
        loop checked
            match n with
            | 1 -> 
                io.write("(break): n=%d{n}, product=%d{product}\n", stdout)
                break product
            | _ -> 
                io.write("(non-break): n=%d{n}, product=%d{product}\n", stdout)
                defer n = n - 1
                product = n * product 
